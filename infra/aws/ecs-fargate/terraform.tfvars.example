# Copy to terraform.tfvars and fill in whichever connectors you want
# live. terraform.tfvars is gitignored -- never commit real values.

aws_region = "us-east-1"
app_name   = "apm-connectors"

# google_client_id        = ""
# google_client_secret    = ""
# google_token_json       = ""  # paste .google_token.json's full contents (see docs/deployment.md)
# ms_graph_client_id      = ""
# ms_graph_client_secret  = ""
# ms_graph_tenant_id      = ""
# apm_excel_drive_file_id = ""
# salesforce_client_id     = ""
# salesforce_client_secret = ""
# salesforce_domain        = ""  # e.g. "my-org-dev-ed.develop.my.salesforce.com"
# salesforce_api_version   = ""  # e.g. "v60.0" -- leave unset to use the connector's default
