# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored — never commit real credentials.

# --- Gmail + Google Calendar ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Desktop app type). Enable the Gmail API and Google Calendar API first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional, for a headless deployment only (e.g. infra/aws/ecs-fargate/) --
# leave unset for local use. src/apm_connectors/tools/google_auth.py's
# normal flow opens a browser and catches the OAuth redirect on this same
# machine's localhost, which a server with no browser can't do. Instead:
# run the local interactive flow once (see docs/running-locally.md), then
# paste the full contents of the resulting .google_token.json here as a
# single-line JSON string. Takes precedence over GOOGLE_CLIENT_ID/SECRET
# above when set.
GOOGLE_TOKEN_JSON=

# --- Excel files: local + Google Drive (src/apm_connectors/tools/excel_file_tool.py) ---
# This is the only Excel connector apm_connectors.api.dependencies.get_tools
# builds.
# Local workbooks need no credentials at all -- just a file path.
# Google-Drive-hosted workbooks reuse GOOGLE_CLIENT_ID/SECRET above (same
# OAuth client, enable the Google Drive API too); requests the full
# `drive` scope (broader than ideal, but the narrower drive.file scope
# only covers files this app created or the user picked via a Google
# Picker, neither true for an existing file the connector is just
# pointed at -- see excel_file_tool.py's module docstring), and caches
# its own token separately from the Gmail/Calendar one
# (.google_drive_token.json, gitignored) so the two consents don't
# overwrite each other's cached scopes.
#
# One workbook per running server -- like Gmail/Calendar's "the
# account". Set AT MOST ONE of the two below (setting both is a startup
# error -- ambiguous which to use):
#   - a local file: APM_EXCEL_WORKBOOK_PATH=/path/to/workbook.xlsx
#   - a Drive file: APM_EXCEL_DRIVE_FILE_ID=<id or name> (either a literal
#     file id, or the file's name e.g. "APM_Invoice_Details.xlsx" --
#     resolved to an id at startup; a name matching zero or more than
#     one Drive file fails loudly rather than guessing.
#     `python scripts/excel_file_demo.py gdrive --list` shows what's there)
# Leave both unset to run without Excel at all -- every /tools/excel/*
# route then 503s.
APM_EXCEL_WORKBOOK_PATH=
APM_EXCEL_DRIVE_FILE_ID=

# --- Salesforce (src/apm_connectors/tools/salesforce_tool.py) ---
# Salesforce Setup -> App Manager -> New Connected App:
#   - Enable OAuth Settings, then under it, enable "Client Credentials Flow"
#     (this connector uses that flow -- no interactive user login, no
#     redirect URI needed; the older Username-Password OAuth flow is
#     deprecated by Salesforce and deliberately not used here).
#   - Assign a "Run As" user for the Client Credentials Flow -- the API
#     calls this connector makes act as that user, so give it only the
#     object/field permissions this integration actually needs.
#   - Consumer Key / Consumer Secret from the Connected App's "Manage
#     Consumer Details" page become the two values below.
# Leave all three unset to run without Salesforce -- every
# /tools/salesforce/* route then 503s, same as Excel with no workbook set.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# My Domain hostname only, no scheme/path, e.g. mycompany.my.salesforce.com
# (Setup -> Company Settings -> My Domain). For a sandbox this is usually
# mycompany--sandboxname.sandbox.my.salesforce.com.
SALESFORCE_DOMAIN=
# Optional -- defaults to "v60.0" if unset (see salesforce_auth.py)
SALESFORCE_API_VERSION=

# --- Jira (src/apm_connectors/tools/jira_tool.py) ---
# Jira Cloud only, authenticated with an Atlassian API token (Basic
# auth: account email + token) -- no interactive login, no redirect
# URI, no separate token-exchange call needed (unlike Salesforce's
# OAuth flow above).
#   - JIRA_BASE_URL: your site's base URL, e.g.
#     https://yourcompany.atlassian.net
#   - JIRA_EMAIL: the Atlassian account email the token belongs to
#   - JIRA_API_TOKEN: create one at
#     https://id.atlassian.com/manage-profile/security/api-tokens --
#     scope the account it belongs to only the projects/permissions
#     this integration actually needs, not a site-admin account.
# Leave all three unset to run without Jira -- every /tools/jira/*
# route then 503s, same as Salesforce with no Connected App configured.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Optional ---
# Where the local status/audit store writes its JSON file (default: ./state)
APM_STATE_DIR=state
